# Runtime connection: must be a NON-owner, NON-superuser role (see docs/PROJECT_CONTEXT.md, "Database roles").
DATABASE_URL=postgresql://gymos_app:change-me@localhost:5432/gymos
# Migration connection: the schema owner. Used only by `prisma migrate deploy`.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/gymos
# 32+ random chars: openssl rand -base64 48
OTP_SECRET=
# SMS Provider: console, msg91, or none
SMS_PROVIDER=console
# MSG91 credentials for production OTP delivery
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Resend API key for transactional emails
RESEND_API_KEY=
# Sender address (e.g. FIXIA GymOS <onboarding@resend.dev> or your verified domain)
EMAIL_FROM=
